{
  "name": "compromised-wallet-rescue",
  "version": "1.0.0",
  "description": "Watch a swept Solana wallet and race the sweeper bot to move arriving tokens to a clean wallet.",
  "license": "MIT",
  "private": false,
  "bin": {
    "sweeper-rescue": "./scripts/sol_rescue.js"
  },
  "scripts": {
    "test": "node scripts/sol_rescue.js test",
    "rescue": "node scripts/sol_rescue.js rescue",
    "auto": "node scripts/sol_rescue.js auto",
    "watch": "python3 scripts/watch_swept_wallet.py",
    "selftest": "node scripts/rescue_selftest.js create",
    "verify": "node scripts/verify.js"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
