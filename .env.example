# Copy to .env and fill in. Never commit the real file.

# the swept address you are protecting
VICTIM=

# the clean wallet that receives rescued tokens and pays the fees
DESTINATION=

# mnemonic that derives the fee payer wallet (or point at a file instead)
# FEE_PAYER_MNEMONIC=
# FEE_PAYER_MNEMONIC_FILE=
FEE_PAYER_DERIVATION="m/44'/501'/3'/0'"

# aggressive priority fee, micro-lamports per compute unit
PRIORITY_MICRO_LAMPORTS=3000000

# detection cadence
POLL_INTERVAL_MS=1500

# telegram alerts (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT=

# where the secret files live (helius_key, quicknode_sol_url, ...)
# SECRETS_DIR=~/.hermes/.secrets
